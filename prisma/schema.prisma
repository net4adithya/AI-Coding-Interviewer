// Prisma Schema for Enterprise-Grade AI Coding Review Platform Backend (Phase 1 Foundation)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

// AssignmentDifficulty enum removed for SQLite compatibility

// AssignmentStatusEnum enum removed for SQLite compatibility

// ------------------------------------------------------
// Core Models
// ------------------------------------------------------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean     @default(true)
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  
  authority    Authority?
  intern       Intern?
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAssignments Assignment[] @relation("CreatedAssignments")

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. AUTHORITY, INTERN
  description String?
  permissions String // JSON or CSV string for permissions
  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model Authority {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      String
  designation     String
  
  managedInterns  Intern[] @relation("AuthorityInterns")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("authorities")
}

model Intern {
  // existing fields ...
  submissions Submission[]
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  authorityId   String?
  authority     Authority?   @relation("AuthorityInterns", fields: [authorityId], references: [id], onDelete: SetNull)
  
  institution   String?
  startDate     DateTime?
  endDate       DateTime?

  assignments   Assignment[] @relation("InternAssignments")

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("interns")
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("sessions")
}

model ProgrammingLanguage {
  // existing fields ...
  submissions Submission[]
  id          String       @id @default(uuid())
  name        String       @unique // e.g. TypeScript, Python, Java
  slug        String       @unique // e.g. typescript, python, java
  isActive    Boolean      @default(true)

  assignments Assignment[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("programming_languages")
}

model AssignmentStatus {
  id          String               @id @default(uuid())
  name        String               @unique
  code        String @unique
  description String?

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("assignment_statuses")
}

model Assignment {
  // existing fields ...
  submissions Submission[]
  id                 String               @id @default(uuid())
  title              String
  description        String
  difficulty   String @default("BEGINNER") // was AssignmentDifficulty

  languageId         String
  language           ProgrammingLanguage  @relation(fields: [languageId], references: [id])

  deadline           DateTime
  status       String @default("DRAFT") // was AssignmentStatusEnum

  internId           String?
  intern             Intern?              @relation("InternAssignments", fields: [internId], references: [id], onDelete: SetNull)

  createdById        String
  createdBy          User                 @relation("CreatedAssignments", fields: [createdById], references: [id])

  // New field for resubmission policy
  allowResubmission  Boolean              @default(false)

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. USER_LOGIN, CREATE_ASSIGNMENT
  resource  String   // e.g. auth, assignments
  details   String? // JSON stored as string

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ------------------------------------------------------
// Future Relation Placeholders (Prepared for Phase 2+)
// ------------------------------------------------------
// Submission & versioning models added for Phase 2

// SubmissionStatus enum removed for SQLite compatibility

model Submission {
  id               String   @id @default(uuid())
  assignmentId     String
  internId         String
  languageId       String
  status       String @default("DRAFT") // was SubmissionStatus
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  currentVersionId String? @unique

  assignment   Assignment   @relation(fields: [assignmentId], references: [id])
  intern       Intern       @relation(fields: [internId], references: [id])
  language     ProgrammingLanguage @relation(fields: [languageId], references: [id])
  currentVersion SubmissionVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions    SubmissionVersion[] @relation("SubmissionVersions")

  @@index([assignmentId])
  @@index([internId])
  @@index([status])
}

model SubmissionVersion {
  id           String   @id @default(uuid())
  submissionId String
  version      Int
  sourceCode   String
  createdAt    DateTime @default(now())

  // Placeholders for future relations
  // aiReviewId   String?
  // executionLogId String?
  // staticAnalysisId String?
  // reportId String?

  submission   Submission @relation("SubmissionVersions", fields: [submissionId], references: [id])
  currentOf    Submission? @relation("CurrentVersion")

  @@unique([submissionId, version])
}

